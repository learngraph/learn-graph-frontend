{
  "name": "learn-graph-frontend-vite",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "devPublic": "vite --host",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test-watch": "vitest",
    "fmt": "prettier --write .",
    "init-git": "ln -sf ../../tools/pre-commit .git/hooks/pre-commit",
    "build-arm": "docker build -t test-frontend --build-arg='NGINX_IMAGE=arm64v8/nginx:stable-alpine' .",
    "build-amd": "docker build -t test-frontend --build-arg='NGINX_IMAGE=nginx:stable-alpine' ."
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@posthog/react": "^1.5.2",
    "@types/node": "^24.10.7",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.1",
    "lucide-react": "^0.503.0",
    "posthog-js": "^1.313.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^17.0.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.6",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.19"
  },
  "proxy": "http://backend:8080"
}
